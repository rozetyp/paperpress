{
  "name": "paperpress",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Markdown to PDF in any company's brand, detected live from its URL. One HTTP call, no API key. REST API + hosted MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rozetyp/paperpress.git"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "markdown-to-pdf",
    "html-to-pdf",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "branding",
    "brand-detection",
    "playwright",
    "fastify"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "playwright install chromium || true"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "color-namer": "^1.4.0",
    "fastify": "^4.28.1",
    "playwright": "^1.47.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "unified": "^11.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/color-namer": "^1.3.3",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "homepage": "https://github.com/rozetyp/paperpress#readme"
}
