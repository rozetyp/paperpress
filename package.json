{
  "name": "paperpress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API that detects a company's brand from its URL and renders markdown into a PDF in that brand, in one HTTP call. Portfolio project, not a maintained product.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rozetyp/paperpress.git"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "markdown-to-pdf",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "branding",
    "brand-detection",
    "playwright",
    "fastify"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate || true && playwright install chromium || true"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.20.0",
    "color-namer": "^1.4.0",
    "fastify": "^4.28.1",
    "playwright": "^1.47.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "unified": "^11.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/color-namer": "^1.3.3",
    "@types/node": "^20.14.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
