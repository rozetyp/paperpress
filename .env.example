# Postgres
DATABASE_URL="postgresql://paperpress:dev@localhost:5432/paperpress"

# Server
PORT=3000
NODE_ENV=development

# Storage
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:3000

# Signing
SIGNING_SECRET=change-me-in-prod-use-openssl-rand-base64-32

# Rendering
PLAYWRIGHT_MAX_CONTEXTS=2
RENDER_TIMEOUT_MS=30000

# Credits
FREE_TIER_CREDITS=100

# Email (Resend) — leave RESEND_API_KEY blank in dev to log emails to stdout
RESEND_API_KEY=
EMAIL_FROM="paperpress <onboarding@paperpress.dev>"
KEY_GRACE_PERIOD_HOURS=24

# Admin surface — leave unset to disable /admin/* routes entirely.
# When set, must be ≥32 chars (use `openssl rand -base64 32`).
ADMIN_TOKEN=
