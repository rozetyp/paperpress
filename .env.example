# Server
PORT=3000
NODE_ENV=development

# Storage
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:3000

# Signing (signed PDF URLs)
SIGNING_SECRET=change-me-in-prod-use-openssl-rand-base64-32

# Rendering
PLAYWRIGHT_MAX_CONTEXTS=2
RENDER_TIMEOUT_MS=30000

# Per-IP render budget, shared by /v1/documents and the MCP tool
RENDERS_PER_HOUR=30
